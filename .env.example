# Copy to .env. Everything is optional: unset integrations run in labelled "simulated" mode.
F2F_DEMO_PACE=1.0
# Amazon Bedrock (agents use Claude via the Converse API when credentials are available)
AWS_PROFILE=
AWS_REGION=ap-southeast-2
# Unset = Nova Lite via the region's inference profile (apac.amazon.nova-lite-v1:0 in ap-southeast-2)
BEDROCK_MODEL_ID=
# EC2 console launch (infra/_launch.sh, see docs/aws.md); unset = discovered or created
KEY_NAME=field-to-fix-key
SG=
INSTANCE_PROFILE=f2f-console-agentcore-profile
DISCOVERY_AGENTCORE_ARN=
RCA_AGENTCORE_ARN=
# Jira Cloud
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT=HU
# GitHub repo holding media-service (the Fix agent pushes a branch and opens a PR)
GITHUB_TOKEN=
GITHUB_REPO=
# Live Reddit search (public JSON endpoint)
F2F_REDDIT_LIVE=0
